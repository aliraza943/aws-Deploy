{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
"scripts": {
  "dev":          "dotenv -e .env.dev -- ts-node-dev src/index.ts",
  "test":         "dotenv -e .env.test -- ts-node src/index.ts",
  "start":        "dotenv -e .env.production -- ts-node src/index.ts",
  "db:generate":  "dotenv -e .env.dev -- drizzle-kit generate",
  "db:migrate":   "dotenv -e .env.dev -- ts-node src/migrate.ts",
  "db:migrate:test": "dotenv -e .env.test -- ts-node src/migrate.ts",
  "db:migrate:prod": "dotenv -e .env.production -- ts-node src/migrate.ts",
  "db:push":      "dotenv -e .env.dev -- drizzle-kit push",
  "db:studio":    "dotenv -e .env.dev -- drizzle-kit studio",
  "db:studio:prod": "dotenv -e .env.production -- drizzle-kit studio"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.30.10",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.21.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
